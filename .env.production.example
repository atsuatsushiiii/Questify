# Copy to `.env` on the production host and fill in real values.
# Never commit the resulting `.env`.

APP_NAME=Questify
APP_ENV=production
APP_DEBUG=false
APP_URL=https://questify.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=questify
DB_USERNAME=questify_app
DB_PASSWORD=replace-with-a-strong-password

SESSION_COOKIE_NAME=questify_session
SESSION_SECURE=true
REMEMBER_COOKIE_NAME=questify_remember

# Password reset and email-change links are delivered over SMTP in production.
# `tls` uses STARTTLS on port 587; `ssl` uses implicit TLS on port 465.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=questify@example.com
MAIL_PASSWORD=replace-with-the-smtp-password
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=no-reply@questify.example.com
MAIL_FROM_NAME=Questify

# Google sign-in (optional). The redirect URI must match the one registered on
# the OAuth client exactly, including scheme, host, path, and trailing slash.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://questify.example.com/auth/google/callback
