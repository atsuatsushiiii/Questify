# Copy to `.env` on the production host and fill in real values.
# Never commit the resulting `.env`.

APP_NAME=Questify
APP_ENV=production
APP_DEBUG=false
APP_URL=https://questify.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=questify
DB_USERNAME=questify_app
DB_PASSWORD=replace-with-a-strong-password

SESSION_COOKIE_NAME=questify_session
SESSION_SECURE=true
REMEMBER_COOKIE_NAME=questify_remember
