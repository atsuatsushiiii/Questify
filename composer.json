{
    "name": "questify/questify",
    "description": "Questify — a gamified productivity platform where everyday tasks become quests.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "migrate": "@php scripts/migrate.php migrate",
        "migrate:status": "@php scripts/migrate.php status",
        "migrate:rollback": "@php scripts/migrate.php rollback",
        "test:auth": "@php tests/auth_flow.php",
        "test:shell": "@php tests/app_shell.php",
        "test:quests": "@php tests/quest_flow.php",
        "test": [
            "@test:auth",
            "@test:shell",
            "@test:quests"
        ]
    }
}
