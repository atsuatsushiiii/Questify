{
    "name": "questify/questify",
    "description": "Questify — a gamified productivity platform where everyday tasks become quests.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "migrate": "@php scripts/migrate.php migrate",
        "migrate:status": "@php scripts/migrate.php status",
        "migrate:rollback": "@php scripts/migrate.php rollback",
        "seed:demo": "@php scripts/seed_demo.php",
        "test:unit": "@php vendor/bin/phpunit --no-coverage",
        "test:auth": "@php tests/auth_flow.php",
        "test:shell": "@php tests/app_shell.php",
        "test:quests": "@php tests/quest_flow.php",
        "test:phase4": "@php tests/phase4_flow.php",
        "test:phase5": "@php tests/phase5_flow.php",
        "test:phase6": "@php tests/phase6_flow.php",
        "test": [
            "@test:unit",
            "@test:auth",
            "@test:shell",
            "@test:quests",
            "@test:phase4",
            "@test:phase5",
            "@test:phase6"
        ]
    }
}
