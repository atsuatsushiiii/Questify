APP_NAME=Questify
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=questify
DB_USERNAME=questify
DB_PASSWORD=

SESSION_COOKIE_NAME=questify_session
SESSION_SECURE=false

# Local development writes reset and email-change links to storage/logs/mail.log.
# Set MAIL_TRANSPORT=smtp and fill the MAIL_* values to send real mail.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@questify.local
MAIL_FROM_NAME=Questify

# Google sign-in (optional). Create an OAuth 2.0 client in Google Cloud Console
# and add APP_URL/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback
