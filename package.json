{
  "name": "questify",
  "version": "0.1.0",
  "private": true,
  "description": "Questify frontend build pipeline",
  "scripts": {
    "dev:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --watch",
    "dev:js": "esbuild ./resources/js/app.js --bundle --sourcemap --target=es2020 --outfile=./public/assets/js/app.js --watch",
    "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --minify",
    "build:js": "esbuild ./resources/js/app.js --bundle --minify --target=es2020 --outfile=./public/assets/js/app.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "gsap": "^3.12.5",
    "lucide": "^0.468.0"
  }
}
